# Operating-system files that are about your machine, not the project
.DS_Store
Thumbs.db

# Editor settings — yours, not the team's
.vscode/
.idea/

# Dependencies get reinstalled from the lockfile, not copied — committing
# them bloats the repo with thousands of files nobody hand-edits
node_modules/

# Holds real credentials (API keys, tokens) once you copy .env.example into
# it — committing this leaks secrets into history, not just the file
.env
